{
  "cricbuzz-safety": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/skills/agentic-engineering/scripts/pre_command_safety.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "cricbuzz-doc-sync-stop": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python .agents/skills/agentic-engineering/scripts/stop_doc_guard.py",
        "timeout": 10
      }
    ]
  }
}
